  "info": {
    "_postman_id": "52c6d738-e0d2-4b6a-bf1e-220211b62e64",
    "name": "CloudBees CI REST API (Jenkins-compatible) Computer Json API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "CloudBees CI exposes the Jenkins remote-access REST API for inspecting and\ncontrolling jobs, builds, queues, and computers. Append `/api/json`,\n`/api/xml`, or `/api/python` to any URL on the controller to retrieve\nmachine-readable metadata. Use the `tree` query parameter to limit the\npayload (recommended for performance). Authenticate with an API token via\nHTTP Basic Auth.\n",
      "type": "text/plain"
    }
